# ZuryoFit environment. Copy to .env for local development; set the same names in your host's
# environment settings for deployments. Never commit real values. Everything below is server-only
# unless its name starts with NEXT_PUBLIC_ (those are inlined into the browser bundle).

# ─── Database (server-only, required) ───────────────────────────────────
# Neon: Project → Dashboard → Connect → "Prisma". Copy both strings.
# DATABASE_URL uses the POOLED host (contains "-pooler"); used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.ap-southeast-1.aws.neon.tech/zuryo?sslmode=require"
# DIRECT_URL uses the DIRECT host (no "-pooler"); used by Prisma Migrate (`npm run db:deploy`).
DIRECT_URL="postgresql://USER:PASSWORD@ep-example-123456.ap-southeast-1.aws.neon.tech/zuryo?sslmode=require"

# ─── Auth (server-only, required) ───────────────────────────────────────
# Signs the NextAuth session JWT. Use a different value per environment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# ─── AI: fitness coach (server-only, optional) ─────────────────────────
# Which vendor to call: auto (default), groq or openrouter. "auto" tries every configured model in
# order — Groq, then OpenRouter's free models; a rate limit, timeout or invalid answer moves to the
# next. An explicit value uses only that vendor. With no key at all the coach uses its rule-based
# replies, labelled as such in the UI. Keys never reach the browser.
AI_PROVIDER="auto"
# Groq free tier: console.groq.com/keys
GROQ_API_KEY=""
# Optional. One model id, or a comma-separated fallback list tried in order. Default:
# "openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b" (free tier; rate limited).
GROQ_MODEL=""
# Optional. The small, fast model the coach uses to classify a question. Default: openai/gpt-oss-20b.
GROQ_FAST_MODEL=""
# OpenRouter free tier: openrouter.ai/keys
OPENROUTER_API_KEY=""
# Optional. One model id, or a comma-separated fallback list tried in order. Default:
# "nvidia/nemotron-3-ultra-550b-a55b:free,recursive/flint-v1.0:free,poolside/laguna-s-2.1:free,google/gemma-4-31b-it:free,openrouter/free" (free models only).
OPENROUTER_MODEL=""

# ─── Scheduled session processing (server-only, optional) ───────────────
# Bearer token for GET /api/cron/session-lifecycle (55-minute warnings + 60-minute completion for
# sessions nobody is looking at). At least 16 characters. Unset = the endpoint answers 503.
CRON_SECRET=""

# ─── Client-safe (inlined into the browser bundle; never put secrets here) ──
# Canonical app URL (metadata, and the HTTP-Referer sent to OpenRouter). Default http://localhost:3000.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Tests only (server-only) ───────────────────────────────────────────
# A SEPARATE, disposable database: `npm run test:integration` migrates it and TRUNCATEs every table,
# and `npm run test:e2e` re-seeds it. The database name must contain "test" and must differ from
# DATABASE_URL, or the suites refuse to run. On Neon: `CREATE DATABASE zuryo_test;` on the same hosts.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.ap-southeast-1.aws.neon.tech/zuryo_test?sslmode=require"
TEST_DIRECT_URL="postgresql://USER:PASSWORD@ep-example-123456.ap-southeast-1.aws.neon.tech/zuryo_test?sslmode=require"
# Optional: port for the Playwright production server (default 3100).
# E2E_PORT=""

# ─── Seed guard (optional) ──────────────────────────────────────────────
# `npm run db:seed` refuses to run when NODE_ENV=production unless this is "1". Only set it for a
# one-off seed of a database that holds nothing but demo data.
# SEED_ALLOW_PRODUCTION="1"
